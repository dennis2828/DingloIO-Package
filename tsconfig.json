{
    "compilerOptions": {
      "declarationDir": "dist/types",
      "emitDeclarationOnly": false,
      "target": "ES6",
      "module": "ES6",
      "moduleResolution": "node",
      "declaration": true,
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }
  